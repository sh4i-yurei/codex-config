{
  "description": "Codex session orientation and targeted formatting",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/session_start.py",
            "timeout": 5,
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/format_patch.py",
            "timeout": 35
          }
        ]
      }
    ]
  }
}
